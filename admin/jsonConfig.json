{
    "i18n": true,
    "type": "tabs",
    "items": {
        "connection": {
            "type": "panel",
            "label": "Connection",
            "items": {
                "connectionMode": {
                    "type": "select",
                    "label": "Connection mode",
                    "help": "Choose one transport: cloud or local. The two are mutually exclusive.",
                    "options": [
                        {
                            "label": "Cloud",
                            "value": "cloud"
                        },
                        {
                            "label": "Local",
                            "value": "local"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "pollInterval": {
                    "type": "number",
                    "label": "Poll interval (seconds)",
                    "help": "How often the adapter polls data from the controller",
                    "min": 5,
                    "max": 3600,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_headerCloud": {
                    "type": "header",
                    "text": "Cloud account",
                    "size": 2,
                    "hidden": "data.connectionMode === 'local'"
                },
                "_cloudInfo": {
                    "type": "staticText",
                    "text": "Capture a refresh token once from an OASE app login (grant_type=refresh_token) and paste it here. Your account password is not needed and is never stored.",
                    "hidden": "data.connectionMode === 'local'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "cloudRefreshToken": {
                    "type": "password",
                    "repeat": false,
                    "label": "Cloud refresh token",
                    "hidden": "data.connectionMode === 'local'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "_cloudAdvanced": {
                    "type": "header",
                    "text": "Cloud (advanced)",
                    "size": 3,
                    "hidden": "data.connectionMode === 'local'"
                },
                "cloudBaseUrl": {
                    "type": "text",
                    "label": "Cloud API base URL",
                    "help": "Advanced — only change if the OASE cloud endpoint moves",
                    "hidden": "data.connectionMode === 'local'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "cloudTokenUrl": {
                    "type": "text",
                    "label": "Cloud token URL",
                    "help": "Advanced — Azure AD B2C token endpoint",
                    "hidden": "data.connectionMode === 'local'",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "cloudClientId": {
                    "type": "text",
                    "label": "Cloud client ID",
                    "help": "Advanced — OAuth client id of the OASE app",
                    "hidden": "data.connectionMode === 'local'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "cloudScope": {
                    "type": "text",
                    "label": "Cloud scope",
                    "help": "Advanced — OAuth scope requested for the access token",
                    "hidden": "data.connectionMode === 'local'",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_headerLocal": {
                    "type": "header",
                    "text": "Local connection",
                    "size": 2,
                    "hidden": "data.connectionMode === 'cloud'"
                },
                "ip": {
                    "type": "text",
                    "label": "Controller IP address",
                    "help": "IP address of the OASE Garden Controller Cloud gateway",
                    "hidden": "data.connectionMode === 'cloud'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "devicePassword": {
                    "type": "password",
                    "repeat": false,
                    "label": "Device password",
                    "hidden": "data.connectionMode === 'cloud'",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "bind": {
                    "type": "ip",
                    "label": "Local server bind address",
                    "listenOnAllPorts": true,
                    "onlyIp4": true,
                    "hidden": "data.connectionMode === 'cloud'",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "port": {
                    "type": "port",
                    "label": "Local server port",
                    "min": 1,
                    "max": 65535,
                    "hidden": "data.connectionMode === 'cloud'",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_headerSchedules": {
                    "type": "header",
                    "text": "Schedules",
                    "size": 2,
                    "newLine": true
                },
                "_pumpList": {
                    "type": "custom",
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomPondpumpSet/Components/PondpumpScheduler",
                    "bundlerType": "module",
                    "i18n": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "pump0": {
            "type": "panel",
            "label": "${(()=>{const s=data.schedules||{};const i=Object.keys(s).filter(k=>s[k]&&s[k].enabled).sort((a,b)=>Number(a)-Number(b));const id=i[0];return id?('Scheduler - '+(s[id].name||('Pump '+id))):'';})()}",
            "hidden": "!(Object.keys(data.schedules||{}).filter(k=>data.schedules[k]&&data.schedules[k].enabled).sort((a,b)=>Number(a)-Number(b))[0])",
            "items": {
                "_pump0": {
                    "type": "custom",
                    "url": "custom/customComponents.js",
